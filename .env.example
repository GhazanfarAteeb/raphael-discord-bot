# MONGODB_URI=mongodb://mongo:27017/raphael
MONGODB_URI=

# ── Cache ─────────────────────────────────────────────────────────────────────
# When using docker-compose, set this to the service name:
# REDIS_URL=redis://redis:6379
REDIS_URL=

# ── Audio (NodeLink) ──────────────────────────────────────────────────────────
NODELINK_HOST=nodelink
NODELINK_PORT=2333
